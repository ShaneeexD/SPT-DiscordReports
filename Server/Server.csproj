<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\SPT API 4.1.0\server-csharp-main\server-csharp-main\Build.props" />
  <PropertyGroup>
    <AssemblyName>DiscordRaidFeed.Server</AssemblyName>
    <RootNamespace>DiscordRaidFeed.Server</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\SPT API 4.1.0\server-csharp-main\server-csharp-main\Libraries\SPTarkov.Common\SPTarkov.Common.csproj" />
    <ProjectReference Include="..\..\SPT API 4.1.0\server-csharp-main\server-csharp-main\Libraries\SPTarkov.DI\SPTarkov.DI.csproj" />
    <ProjectReference Include="..\..\SPT API 4.1.0\server-csharp-main\server-csharp-main\Libraries\SPTarkov.Reflection\SPTarkov.Reflection.csproj" />
    <ProjectReference Include="..\..\SPT API 4.1.0\server-csharp-main\server-csharp-main\Libraries\SPTarkov.Server.Core\SPTarkov.Server.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="config\config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DeployMod" AfterTargets="PostBuildEvent">
    <PropertyGroup><DeployDir>C:\SPT\SPT_Runtime\user\mods\DiscordRaidFeed</DeployDir></PropertyGroup>
    <RemoveDir Directories="$(DeployDir)" />
    <MakeDir Directories="$(DeployDir)\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(ProjectDir)package.json" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(ProjectDir)config\config.json" DestinationFolder="$(DeployDir)\config" />
  </Target>
</Project>
